# Copia este archivo como .env y rellénalo. No lo subas nunca a GitHub.

# De tu app en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Opcional con Vercel Blob (el token se guarda solo). Sin Blob, pega aquí el que muestra /callback
SPOTIFY_REFRESH_TOKEN=

# Cadena larga y aleatoria. Genera una con:  openssl rand -hex 32
MCP_SECRET=

# URL pública del servicio, sin barra final. En local déjala vacía.
# Ejemplo en Render: https://spotify-mcp-javi.onrender.com
PUBLIC_URL=

# Opcional. Si existe, /cron/log-plays exige "Authorization: Bearer <valor>"
CRON_SECRET=

PORT=3000
